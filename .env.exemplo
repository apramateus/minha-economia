# Copie para .env.local e preencha (o .env.local nunca vai para o git).
# dashboard.pluggy.ai → sua aplicação → Client ID / Client Secret
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# dashboard.pluggy.ai → a SUA aplicação → "Iniciar Demo" → conecte o MeuPluggy → abra o item → "Copiar Item ID" (passo a passo: INSTALAR.md)
# Um por banco conectado; vários separados por vírgula.
PLUGGY_ITEM_IDS=
# Item novo em teste: só entra em `npm run sincronizar -- --simular --novo`; depois de conferir, vai para PLUGGY_ITEM_IDS.
PLUGGY_ITEM_ID_NOVO=

# ---- só para quem põe o app no ar (Vercel); em casa, nada disto é preciso ----
# Onde ficam os dados: "arquivo" (padrão, data/ neste computador) ou "blob" (store privada da Vercel).
MINHA_ECONOMIA_DEPOSITO=
# Token da store de dados (a Vercel preenche no projeto; no Mac vem do `vercel link`/`vercel env pull`).
BLOB_READ_WRITE_TOKEN=
# Senha do app no ar: guarde o SHA-256 dela, nunca a senha (use `npm run senha`).
APP_SENHA_HASH=
# Chave que assina o cookie de quem já entrou. Trocar = derrubar todos os aparelhos.
APP_SEGREDO=
# Segredo que a Vercel manda no cron diário da sincronização.
CRON_SECRET=
