{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [{ "source": "/entrar", "destination": "/entrar.html" }],
  "crons": [{ "path": "/api/cron/sincronizar", "schedule": "0 11 * * *" }],
  "functions": {
    "api/dados/*.ts": { "includeFiles": "seed/**" },
    "api/banco/*.ts": { "includeFiles": "seed/**", "maxDuration": 60 },
    "api/cron/*.ts": { "includeFiles": "seed/**", "maxDuration": 60 }
  }
}
